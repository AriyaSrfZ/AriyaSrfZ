# ==============================================================================
# Sovereign n8n Automation Engine - Environment Variables Template
# ==============================================================================
# Copy this file to .env in n8n/ or /home/fersta/n8n_data/.env on smart-db:
#   cp .env.example .env
#
# Docker Compose will automatically load .env and populate container variables.
# ==============================================================================

# Telegram Bot Token used by:
# - workflows/01_daily_freelance_and_bounty_hunter.json
# - workflows/04_full_autonomous_job_hunt_and_outreach_pipeline.json
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Crawl4AI Base URL used by:
# - templates/linkedin_job_automation_community.json
# Default points to host gateway if running Crawl4AI on the host machine:
CRAWL4AI_API_BASE_URL=http://host.docker.internal:11235
