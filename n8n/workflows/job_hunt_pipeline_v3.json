    {
      "id": "4359bd24-9ddd-44ac-9aec-19cafba1c9ae",
      "name": "Scrape LinkenIn Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        -4000,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.apify.com/v2/acts/{{ $json.ActorId }}/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"date_posted\": \"week\",\n  \"experienceLevel\": {{ $json.ExperienceLevel.toJsonString() }},\n  \"keywords\": {{ $json.JobKeywords.toJsonString() }},\n  \"limit\": {{ $json.JobsToScrape }},\n  \"under_10_applicants\": {{ $json.Under10Applicants.toJsonString() }},\n  \"sort\": \"relevant\",\n  \"location\": \"100994116\",\n  \"page_number\": 1\n}",
        "options": {}
      },
      "typeVersion": 4.2,
      "credentials": {
